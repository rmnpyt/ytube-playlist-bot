# Keep the build context small and free of local state. Everything the image
# needs is copied explicitly by the Dockerfile.
.git
.github
.gitignore
.dockerignore

# Tests run in CI, not inside the runtime image.
tests/

# Local state must never leak into an image layer.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

data/
downloads/
*.db
*.db-journal
*.sqlite3
cookies.txt
certs/

.env
.env.*
!.env.example

.idea/
.vscode/

# ---------------------------------------------------------------------------
# ytube-playlist-bot configuration
#
#   cp .env.example .env      # then fill in the required values
#
# .env is gitignored. This file is the only place configuration is documented,
# so keep the two in step when adding a setting.
#
# Get TELEGRAM_API_ID / TELEGRAM_API_HASH from https://my.telegram.org
# (API development tools). They are required by the local Bot API server.
# ---------------------------------------------------------------------------


# === Required ==============================================================

# From @BotFather. Never share it, never commit it.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-real-token

# Numeric application id from my.telegram.org.
TELEGRAM_API_ID=000000

# 32 character application hash from my.telegram.org.
TELEGRAM_API_HASH=replace-with-your-real-api-hash

# Telegram user IDs allowed to use the bot and to approve access requests.
# Comma separated, or JSON style: 12345, 67890
# An admin is always allowed, whether or not they are listed here.
ADMIN_USER_IDS=123456789


# === Optional ==============================================================

# --- Who may use the bot ---------------------------------------------------
# Empty means only admins can use it. Everyone else gets a "request access"
# button that creates an entry an admin can approve.
ALLOWED_USER_IDS=


# --- Telegram connection ---------------------------------------------------
# Base URL of the Bot API server. The default points at the sibling container in
# docker-compose.yml. It must not contain the token: python-telegram-bot appends
# it. Use https://api.telegram.org/bot for the cloud API, which caps uploads at
# 50 MB and therefore disables everything above MAX_UPLOAD_MB.
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081/bot

# Keep true while using the local server. It makes getFile return an absolute
# path, so a 2 GB file is never copied back and forth over HTTP.
TELEGRAM_BOT_API_LOCAL=true


# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:////data/bot.db

# Where downloads land. Removed after every upload, and swept by the janitor if
# a process dies mid-transfer. Must be an absolute path.
DOWNLOAD_DIR=/data/downloads

# Consumed by the telegram-bot-api container, not by the bot.
BOT_API_DATA_DIR=/var/lib/telegram-bot-api

# Optional Netscape-format cookie file, for age restricted or members-only
# videos. Export one from a logged-in browser and mount it at this path.
# Support for this is deferred; the variable is accepted so a deployment can be
# prepared without a code change.
YOUTUBE_COOKIES_FILE=


# --- Limits ----------------------------------------------------------------
# Hard ceiling on a single upload, in megabytes. The local Bot API server
# rejects anything above 2000 MB, so this cannot be raised beyond 2000.
# Quality options above this size are removed from the menu.
MAX_UPLOAD_MB=2000

# Upper bound on how many videos one playlist request may deliver.
MAX_PLAYLIST_ITEMS=50

# How many downloads may run at once. Raise only with a faster disk: the
# VPS disk, not the CPU, is the bottleneck.
MAX_CONCURRENT_DOWNLOADS=1

# Requests allowed per user per hour.
RATE_LIMIT_PER_HOUR=10

# Show quality options whose file size YouTube does not report. Off by default,
# because the size guard cannot rule out a file that turns out to be too big.
ALLOW_UNKNOWN_SIZES=false


# --- Housekeeping ----------------------------------------------------------
# A partial file older than this is deleted by the janitor.
ORPHAN_TTL_SECONDS=21600

# How often the janitor runs.
JANITOR_INTERVAL_SECONDS=900

# Refuse new downloads when free disk falls below this. Downloading a 2 GB file
# with 500 MB free fills the volume and takes the bot down with it.
DISK_FREE_THRESHOLD_GB=5


# --- Observability ---------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# JSON in production, a colourised console locally.
LOG_JSON=true

# Where the health and metrics endpoints listen. Bound inside the container
# network; Traefik or a local curl can reach it.
METRICS_HOST=0.0.0.0
METRICS_PORT=9090
